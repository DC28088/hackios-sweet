+// RAM tables describe banks; the GCD map also contains SEC/DXE reservations.
+// Register only gaps so the copied HackiOS payload remains reserved.
+STATIC
+EFI_STATUS
+AddUnclaimedRam (
+  IN EFI_PHYSICAL_ADDRESS Base,
+  IN UINT64               Length,
+  IN UINT64               ArmAttributes,
+  IN EFI_MEMORY_TYPE      EfiMemoryType)
+{
+  EFI_STATUS                      Status;
+  EFI_GCD_MEMORY_SPACE_DESCRIPTOR Descriptor;
+  UINT64                          Remaining;
+  UINT64                          Chunk;
+
+  Remaining = Length;
+  while (Remaining != 0) {
+    Status = gDS->GetMemorySpaceDescriptor (Base, &Descriptor);
+    if (EFI_ERROR (Status)) { return Status; }
+    if (Descriptor.BaseAddress > Base ||
+        Base - Descriptor.BaseAddress >= Descriptor.Length) {
+      return EFI_COMPROMISED_DATA;
+    }
+    // Subtraction avoids overflowing a descriptor whose end is UINT64_MAX+1.
+    Chunk = MIN (Remaining, Descriptor.Length - (Base - Descriptor.BaseAddress));
+    if (Descriptor.GcdMemoryType == EfiGcdMemoryTypeNonExistent) {
+      Status = AddRamPartition (Base, Chunk, ArmAttributes, EfiMemoryType);
+      if (EFI_ERROR (Status)) { return Status; }
+    } else if (Descriptor.GcdMemoryType == EfiGcdMemoryTypeSystemMemory) {
+      AnyRamPartitionAdded = TRUE;
+    } else {
+      DEBUG ((EFI_D_WARN, "Preserving GCD reservation: 0x%llx 0x%llx type %u\n",
+              Base, Chunk, (UINT32)Descriptor.GcdMemoryType));
+    }
+    Base += Chunk;
+    Remaining -= Chunk;
+  }
+  return EFI_SUCCESS;
 }
 
